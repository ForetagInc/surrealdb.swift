# Pinned native dependency for the embedded (mem://) engine.
# Bumping any value here is an explicit, reviewed commit: it busts the CI cache
# and changes the bytes we link into every app.

SURREALDB_C_REPO="https://github.com/surrealdb/surrealdb.c.git"
# surrealdb.c has no tags and no releases, so we pin a commit.
# main @ 2026-03-06 "Fix build on Rust 1.94+ by increasing recursion_limit (#13)"
SURREALDB_C_REF="039481e0c46fcd9c4096a9eaf85ec3a8fadf80ec"

# surrealdb.c requires >= 1.94 (recursion_limit fix, PR #13).
RUST_STABLE="1.94.1"
